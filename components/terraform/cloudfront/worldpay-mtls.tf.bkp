locals {
  enable_worldpay_mtls = var.environment == "live"
}

resource "aws_s3_bucket" "worldpay_mtls" {
  count = local.enable_worldpay_mtls ? 1 : 0

  bucket = "ds-${var.environment}-worldpay-mtls"

  tags = merge(var.default_tags, {
    service = "web"
  })
}

resource "aws_s3_bucket_public_access_block" "worldpay_mtls" {
  count = local.enable_worldpay_mtls ? 1 : 0

  bucket = aws_s3_bucket.worldpay_mtls[0].id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "worldpay_mtls" {
  count = local.enable_worldpay_mtls ? 1 : 0

  bucket = aws_s3_bucket.worldpay_mtls[0].id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_object" "worldpay_ca_bundle" {
  count = local.enable_worldpay_mtls ? 1 : 0

  bucket = aws_s3_bucket.worldpay_mtls[0].id
  key    = "worldpay-ca-bundle.pem"

  source = "${pathexpand("~")}/worldpay-certs/worldpay-ca-bundle.pem"

  etag = filemd5(
    "${pathexpand("~")}/worldpay-certs/worldpay-ca-bundle.pem"
  )

  server_side_encryption = "AES256"
}

resource "aws_cloudfront_trust_store" "worldpay" {
  count = local.enable_worldpay_mtls ? 1 : 0

  name = "ds-${var.environment}-worldpay-mtls"

  ca_certificates_bundle_source {
    ca_certificates_bundle_s3_location {
      bucket = aws_s3_bucket.worldpay_mtls[0].id
      key    = aws_s3_object.worldpay_ca_bundle[0].key
      region = "eu-west-2"
    }
  }
}
