#!/bin/bash

SOURCE_DIR="/media"
TMP_DIR="/media/.backup-zips"
S3_BUCKET="s3://{{ s3_deployment_bucket }}/wagtail-content"
LOG_FILE="/var/log/media_backup.log"

TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
ZIP_NAME="media-backup-$TIMESTAMP.zip"
ZIP_PATH="$TMP_DIR/$ZIP_NAME"

sudo mkdir -p "$TMP_DIR"
sudo mkdir -p /var/log

UPDATED_FILES=$(find "$SOURCE_DIR" -type f ! -name "wagtail-content.zip")

cd "$SOURCE_DIR"
echo "$UPDATED_FILES" | zip -@ "$ZIP_PATH"

if [ $? -ne 0 ]; then
    echo "$(date): ERROR: Failed to create backup $ZIP_PATH" | sudo tee -a "$LOG_FILE"
    exit 1
fi

if sudo aws s3 cp "$ZIP_PATH" "$S3_BUCKET/$ZIP_NAME"; then
    echo "$(date): Successfully uploaded backup $ZIP_PATH to $S3_BUCKET/$ZIP_NAME" | sudo tee -a "$LOG_FILE"
    sudo rm -f "$ZIP_PATH"
else
    echo "$(date): ERROR: Failed to upload backup $ZIP_PATH to $S3_BUCKET/$ZIP_NAME" | sudo tee -a "$LOG_FILE"
    exit 1
fi
